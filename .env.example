# ─── Server Environment Configuration ────────────────────────────────────────
PORT=5000

# ─── Database ─────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxx.mongodb.net/schooldb

# ─── JWT Authentication ───────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_secure_random_string
JWT_REFRESH_SECRET=change_this_to_a_different_secure_string
JWT_EXPIRES_IN=7d

# ─── CORS ────────────────────────────────────────────────────────────────────
CLIENT_ORIGIN=http://localhost:5173

# ─── Cloudinary (for image uploads) ─────────────────────────────────────────
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# ─── AI Provider Configuration ───────────────────────────────────────────────
#
# Which AI provider to use for the chat assistant.
# Options: 'nvidia' | 'groq' | 'gemini'
# Default: 'nvidia' (or 'groq')
#
AI_PROVIDER=nvidia

# Fallback provider if the primary fails (for read-only operations).
# Options: 'nvidia' | 'groq' | 'gemini' | 'none'
# Set to 'none' to disable failover.
AI_FALLBACK_PROVIDER=none

# ─── NVIDIA NIM AI ───────────────────────────────────────────────────────────
# Get your API key at: https://build.nvidia.com/
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b

# ─── Groq (Primary) ──────────────────────────────────────────────────────────
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Model to use. Recommended: llama-3.3-70b-versatile (best tool-calling support)
# Other options: llama3-70b-8192, mixtral-8x7b-32768
GROQ_MODEL=llama-3.3-70b-versatile

# ─── Google Gemini (Secondary / Fallback) ────────────────────────────────────
# Get your key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Model to use. Options: gemini-1.5-flash (fast), gemini-1.5-pro (better reasoning)
GEMINI_MODEL=gemini-1.5-flash
